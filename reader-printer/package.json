{
  "name": "reader-printer",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.13.2",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsdom": "^27.0.1"
  },
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.readerprinter.app",
    "productName": "Reader Printer",
    "asarUnpack": [
      "server.js"
    ],
    "files": [
      "**/*",
      "!**/*.{md,txt}",
      "!**/*.map",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!**/__tests__/**/*",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/example/**/*",
      "!**/examples/**/*",
      "!**/docs/**/*",
      "!**/.github/**/*",
      "!**/.git/**/*",
      "!**/node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme,LICENSE,LICENSE.txt,license,History.md,CONTRIBUTING.md,AUTHORS,Makefile}",
      "!**/node_modules/**/*.{md,txt,map}",
      "!**/node_modules/**/test/**/*",
      "!**/node_modules/**/tests/**/*",
      "!**/node_modules/**/__tests__/**/*",
      "!**/node_modules/**/*.test.js",
      "!**/node_modules/**/*.spec.js"
    ],
    "compression": "maximum",
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
